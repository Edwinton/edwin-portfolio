# about-profile.ps1 — add a detailed profile card to the About page
$root = "C:\Users\User\OneDrive\Desktop\html page\edwin-portfolio"
if (-not (Test-Path $root)) { Write-Host "Project not found: $root" -ForegroundColor Red; exit 1 }
Set-Location $root
$utf8 = New-Object System.Text.UTF8Encoding $false

Write-Host "`n[1/4] site.json — add profile data ----------" -ForegroundColor Cyan
$py = @'
import json
from pathlib import Path
p = Path("data/site.json")
d = json.loads(p.read_text(encoding="utf-8-sig"))

about = d["pages"]["about"]
about.setdefault("profile", {
    "initials": "ET",
    "name": d.get("name", "Edwin Tony"),
    "role": "Computer Science Student · Aspiring Software Developer",
    "status": "Currently exploring AI-assisted development and building small web tools.",
    "facts": [
        {"label": "Location",   "value": "Kottayam, Kerala, India"},
        {"label": "Focus",      "value": "Software development · AI & ML"},
        {"label": "Studying",   "value": "Integrated M.Sc. CS (AI & ML)"},
        {"label": "College",    "value": "BVM, Cherpunkal"},
        {"label": "Expected",   "value": "2031"},
        {"label": "Languages",  "value": "English, Malayalam"},
        {"label": "Open to",    "value": "Internships · Remote roles"}
    ],
    "links": [
        {"label": "Email",    "href": "mailto:edwinveedon@gmail.com", "icon": "mail"},
        {"label": "GitHub",   "href": "https://github.com/Edwinton", "icon": "github"},
        {"label": "LinkedIn", "href": "https://www.linkedin.com/in/edwin-tony-267977393/", "icon": "linkedin"}
    ]
})
p.write_text(json.dumps(d, indent=2, ensure_ascii=False), encoding="utf-8")
print("  profile added to pages.about")
'@
[System.IO.File]::WriteAllText("$root\_a.py", $py, $utf8)
python "$root\_a.py"
Remove-Item "$root\_a.py"

Write-Host "`n[2/4] templates/about.html — render the card ----------" -ForegroundColor Cyan
$tpl = @'
<section class="section page-section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ page.eyebrow }}</p>
      <h2>{{ page.heading }}</h2>
    </div>

    <div class="about-layout">
      <div class="about-text">{{ page.paragraphs_html }}</div>

      <aside class="profile-card">
        <div class="profile-card-head">
          <div class="profile-card-avatar">{{ page.profile.initials }}</div>
          <div>
            <h3 class="profile-card-name">{{ page.profile.name }}</h3>
            <p class="profile-card-role">{{ page.profile.role }}</p>
          </div>
        </div>

        <p class="profile-card-status">{{ page.profile.status }}</p>

        <dl class="profile-card-facts">
          {{ page.profile.facts_html }}
        </dl>

        <div class="profile-card-links">
          {{ page.profile.links_html }}
        </div>
      </aside>
    </div>

    <ul class="about-facts">{{ page.facts_html }}</ul>
  </div>
</section>
'@
[System.IO.File]::WriteAllText("$root\templates\about.html", $tpl, $utf8)
Write-Host "  wrote: templates/about.html" -ForegroundColor DarkGray

Write-Host "`n[3/4] build.py — build profile HTML fragments ----------" -ForegroundColor Cyan
$py = @'
import re
from pathlib import Path

p = Path("build.py")
src = p.read_text(encoding="utf-8")

# Add profile processing inside prepare(), after the `about` block
anchor = '''    about = pages.get("about", {})
    if "paragraphs" in about:
        about["paragraphs_html"] = paragraphs_html(about["paragraphs"])
    if "facts" in about:
        about["facts_html"] = facts_html(about["facts"])
'''

insert = anchor + '''

    # About profile card fragments
    prof = about.get("profile", {})
    if prof:
        facts = []
        for f in prof.get("facts", []):
            facts.append(
                f'<div class="profile-card-fact">'
                f'<dt>{f["label"]}</dt><dd>{f["value"]}</dd></div>'
            )
        prof["facts_html"] = "\\n".join(facts)

        links = []
        for l in prof.get("links", []):
            links.append(
                f'<a class="profile-card-link" href="{l["href"]}" '
                f'{"target=\\"_blank\\" rel=\\"noopener\\"" if l["href"].startswith("http") else ""}>'
                f'<i data-lucide="{l.get("icon", "link")}"></i>'
                f'<span>{l["label"]}</span></a>'
            )
        prof["links_html"] = "\\n".join(links)
'''

if "profile-card-fact" not in src:
    if anchor in src:
        src = src.replace(anchor, insert, 1)
        p.write_text(src, encoding="utf-8")
        print("  patched: build.py (profile fragments)")
    else:
        print("  ERROR: anchor not found — check build.py's prepare() function")
else:
    print("  build.py already builds profile fragments")
'@
[System.IO.File]::WriteAllText("$root\_b.py", $py, $utf8)
python "$root\_b.py"
Remove-Item "$root\_b.py"

Write-Host "`n[4/4] sections.css — profile card styles ----------" -ForegroundColor Cyan
$cssPath = Join-Path $root "static\css\sections.css"
$css = [System.IO.File]::ReadAllText($cssPath)
if ($css -notmatch "profile-card-avatar") {
    $css += @'

/* ---------- About profile card ---------- */
.about-layout {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: var(--s-7);
  align-items: start;
  margin-bottom: var(--s-7);
}

.profile-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--s-5);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: calc(var(--header-h) + 24px);
}
.profile-card-head {
  display: flex;
  align-items: center;
  gap: var(--s-4);
  margin-bottom: var(--s-4);
}
.profile-card-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--green-700), var(--green-900));
  color: var(--white);
  display: grid;
  place-items: center;
  font-family: var(--mono);
  font-weight: 800;
  font-size: 1.1rem;
  flex-shrink: 0;
}
.profile-card-name {
  font-size: 1.05rem;
  margin: 0;
  color: var(--ink);
}
.profile-card-role {
  font-size: 0.82rem;
  color: var(--green-700);
  font-weight: 500;
  margin: 2px 0 0;
  line-height: 1.3;
}
.profile-card-status {
  font-size: 0.88rem;
  color: var(--ink-soft);
  padding: var(--s-3);
  background: var(--surface);
  border-radius: var(--r-sm);
  margin: 0 0 var(--s-4);
  line-height: 1.5;
}
.profile-card-facts {
  display: grid;
  gap: 0;
  margin: 0 0 var(--s-4);
}
.profile-card-fact {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--s-3);
  align-items: baseline;
  padding: var(--s-2) 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.84rem;
}
.profile-card-fact:last-child { border-bottom: none; }
.profile-card-fact dt {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-mute);
}
.profile-card-fact dd {
  margin: 0;
  color: var(--ink-soft);
  text-align: right;
}
.profile-card-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-2);
  padding-top: var(--s-4);
  border-top: 1px solid var(--border);
}
.profile-card-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: var(--s-2);
  border-radius: var(--r-sm);
  color: var(--ink-soft);
  font-size: 0.72rem;
  font-weight: 600;
  transition: background .15s, color .15s;
  text-align: center;
}
.profile-card-link:hover {
  background: var(--green-50, #f2f7f4);
  color: var(--green-700);
}
.profile-card-link svg {
  width: 16px;
  height: 16px;
  stroke-width: 2;
}

@media (max-width: 900px) {
  .about-layout { grid-template-columns: 1fr; }
  .profile-card { position: static; }
}
'@
    [System.IO.File]::WriteAllText($cssPath, $css, $utf8)
    Write-Host "  appended profile card styles" -ForegroundColor DarkGray
} else {
    Write-Host "  profile card styles already present" -ForegroundColor DarkGray
}

Write-Host "`nDone. Rebuild:" -ForegroundColor Green
Write-Host "  python build.py" -ForegroundColor Yellow
Write-Host "  python admin.py" -ForegroundColor Yellow
Write-Host "`nOpen http://localhost:8000/about.html" -ForegroundColor Yellow